  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --go --ios",
    "web": "expo start --web --localhost --port 8091",
    "build:web": "expo export --platform web",
    "release:verify": "node scripts/verify-production-release.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "android": "expo start --go --android",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "build:android": "expo export --platform android --output-dir dist-android",
    "start:go": "expo start --go --lan --clear",
    "start:go:tunnel": "expo start --go --tunnel --clear",
