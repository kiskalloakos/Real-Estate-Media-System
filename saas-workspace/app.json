{
  "expo": {
    "name": "Agency Workspace",
    "slug": "agency-workspace",
    "description": "A modular workspace for real estate content agencies.",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/images/realty-media-brandmark-blue-background.png",
    "scheme": "agencyworkspace",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "icon": "./assets/images/realty-media-brandmark-blue-background.png",
      "bundleIdentifier": "ro.realtymedia.workspace",
      "supportsTablet": true,
      "requireFullScreen": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94a71489-435c-4435-bcbf-03d2536cb59c"
      }
    },
    "android": {
      "package": "ro.realtymedia.workspace",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/realty-media-brandmark-blue-background.png",
        "backgroundColor": "#5256E0"
      }
    },
    "owner": "kiskalloakos"
  }
}
